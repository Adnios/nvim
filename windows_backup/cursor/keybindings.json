    // --------
    // neovim
    // my thought: only terminal, explorer and editorText are belong to neovim, others (like scm) is not handled by neovim
    // --------
    // make neovim keymaping work in sidebar
    // https://code.visualstudio.com/api/references/when-clause-contexts#conditional-operators
    {
        "key": "space",
        "command": "vscode-neovim.send",
        "when": "!inputFocus",
        "args": "<space>"
    },
    {
        "key": "ctrl+l",
        "command": "vscode-neovim.send",
        "when": "sideBarFocus",
        "args": "<C-l>"
    },
    // { "key": "ctrl+;", "command": "vscode-neovim.send", "args": "<C-;>" },
    {
        "key": "ctrl+k",
        "when": "panelFocus",
        "command": "workbench.action.navigateUp"
    },
    {
        "key": "ctrl+h",
        "when": "panelFocus",
        "command": "workbench.action.navigateLeft"
    },
    // copy staff
    // https://github.com/theol0403/dotfiles/blob/master/.config/Code/User/keybindings.json
    {
        "command": "editor.action.clipboardCopyAction",
        "key": "ctrl+shift+c"
    },
    {
        "command": "problems.action.copy",
        "key": "ctrl+shift+c",
        "when": "problemFocus"
    },
    {
        "command": "-workbench.action.terminal.openNativeConsole",
        "key": "ctrl+shift+c",
        "when": "!terminalFocus"
    },
    // https://github.com/vscode-neovim/vscode-neovim?tab=readme-ov-file#keybinding-passthroughs
    {
        "key": "ctrl+d",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.init",
        "args": "<C-d>"
    },
    {
        "key": "ctrl+u",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.init",
        "args": "<C-u>"
    },
    {
        "key": "ctrl+f",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.init",
        "args": "<C-f>"
    },
    {
        "key": "ctrl+b",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.init",
        "args": "<C-b>"
    },
    //
    // use ':' key for commands even if no editor tab is opened (not working)
    //
    {
        "key": "Shift+.",
        "command": "vscode-neovim.send",
        "when": "!inputFocus && !editorTextFocus",
        "args": ":"
    },
    // war for ctrl+^. vscode-neovim.send has bugs
    {
        "key": "ctrl+6",
        "command": "vscode-neovim.send",
        "args": "<C-^>"
    },
    // end
    {
        "key": "q",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && listFocus && !inputFocus"
    },
    // { "key": "ctrl+6", "command": "-workbench.action.focusSixthEditorGroup" },
    // {
    //     "key": "ctrl+6",
    //     "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
    //     "when": "!activeEditorGroupEmpty"
    // },
    // try to get same key as neotree. tab == o (vscode-neovim), o == enter(vscode-neovim)
    {
        "key": "tab",
        "command": "list.toggleExpand",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "o",
        "command": "list.select",
        "when": "filesExplorerFocus && listFocus && !inputFocus && !notebookCellListFocused"
    },
    {
        "key": "shift+r",
        "command": "workbench.files.action.refreshFilesExplorer",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "h",
        "command": "breadcrumbs.focusPreviousWithPicker",
        "when": "breadcrumbsActive && breadcrumbsVisible && listFocus && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "l",
        "command": "breadcrumbs.focusNextWithPicker",
        "when": "breadcrumbsActive && breadcrumbsVisible && listFocus && !inputFocus && !treestickyScrollFocused"
    },
    // hacky :)
